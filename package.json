{
	"name": "@didcat/pizza-design",
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"build": "tsdown && svelte-package -i src/svelte -o dist/svelte",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"prepack": "pnpm run check && pnpm run build"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json",
		"./svelte": {
			"types": "./dist/svelte/index.d.ts",
			"svelte": "./dist/svelte/index.js",
			"default": "./dist/svelte/index.js"
		},
		"./styles/*.css": "./dist/styles/*.css"
	},
	"files": [
		"dist",
		"src"
	],
	"sideEffects": [
		"**/*.css"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://npm.pkg.github.com"
	},
	"dependencies": {
		"iconify-icon": "^3.0.2",
		"svelte-highlight": "7.15.0",
		"title-case": "^4.3.2"
	},
	"peerDependencies": {
		"daisyui": "^5.6.3",
		"svelte": "^5.0.0",
		"tailwindcss": "^4.3.0"
	},
	"peerDependenciesMeta": {
		"svelte": {
			"optional": true
		}
	},
	"devDependencies": {
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^25.9.5",
		"@typescript/native-preview": "7.0.0-dev.20260509.2",
		"daisyui": "^5.6.13",
		"prettier": "^3.9.4",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.1",
		"tailwindcss": "^4.3.2",
		"tsdown": "^0.22.5",
		"typescript": "^6.0.3",
		"vite": "^8.1.3"
	},
	"description": "Opinionated Svelte 5 components and a Tailwind CSS 4 + daisyUI theme.",
	"license": "MPL-2.0",
	"packageManager": "pnpm@11.26.0",
	"engines": {
		"node": ">=22.18.0"
	},
	"types": "./dist/index.d.mts"
}
